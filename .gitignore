# Datasets (never commit CASIA-WebFace, LFW, or any other face data)
data/raw/
data/processed/
data/splits/
data/**/*.jpg
data/**/*.jpeg
data/**/*.png
data/**/*.bmp
# Raw CASIA-WebFace download, extracted at the repo root
/webface_112x112/
# LFW photos fetched by scripts/fetch_demo_test_photos.py for trying the demo
/demo_test_photos/
# Exported viz data/pages embed actual (small) face thumbnails from the
# dataset -- fine to keep locally for personal analysis, but not for the
# public git repo (same redistribution concern as the raw dataset).
docs/embedding_viz_data.json
docs/embedding_explorer.html
# TODO: add an entry here for each future eval dataset folder (LFW,
# AgeDB-30, CFP-FP, CPLFW, ...) as soon as it's downloaded and its actual
# extracted folder name is known -- do not assume *.zip alone covers it.
*.zip
*.tar
*.tar.gz

# Checkpoints / large generated artifacts
runs/
outputs/
logs/
wandb/
*.pt
*.pth
*.onnx
*.ckpt
# checkpoints/ is ignored by default, except the baseline checkpoint, which
# is small (~28MB) and is what the demo needs to run out-of-the-box.
checkpoints/*
!checkpoints/baseline/
checkpoints/baseline/*
!checkpoints/baseline/epoch_29.pt

# Python
__pycache__/
*.pyc
*.pyo
.venv/
.venv*/
venv/
env/
*.egg-info/
build/
dist/

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

